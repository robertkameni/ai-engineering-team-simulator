# Copy to .env.local and fill in (never commit secrets).

# DeepSeek (required for /api/simulate)
DEEPSEEK_API_KEY=

# Neon Postgres — pooled connection string (Vercel + Prisma)
# https://neon.tech/docs/connect/connect-from-vercel
DATABASE_URL=

# Optional: direct / non-pooled URL for Prisma migrations (Neon dashboard)
# DIRECT_URL=

# Auth — JWT session signing (required in production)
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public app origin (Origin allowlist for mutating /api + synthesize worker)
# Local: http://localhost:3100
# Production: https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Upstash Redis (rate limiting — required in production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ENABLED_IN_DEV=true
# RATE_LIMIT_SIMULATE_GUEST=3
# RATE_LIMIT_SIMULATE_AUTH=30
# RATE_LIMIT_REGENERATE_GUEST=3
# RATE_LIMIT_REGENERATE_AUTH=10
# RATE_LIMIT_EXPORT_PDF=5
# RATE_LIMIT_DELETE=30
# RATE_LIMIT_AUTH_LOGIN=10
# RATE_LIMIT_AUTH_REGISTER=10
# RATE_LIMIT_DISABLED=true

# Per-run cost ceiling in USD (classification + debate + artifacts + regeneration)
# SIMULATION_MAX_COST_USD=0.75

# Optional DeepSeek v4 pricing overrides (USD per million tokens)
# Defaults: https://api-docs.deepseek.com/quick_start/pricing
# DEEPSEEK_FLASH_INPUT_USD_PER_M=0.14
# DEEPSEEK_FLASH_OUTPUT_USD_PER_M=0.28
# DEEPSEEK_FLASH_CACHED_INPUT_USD_PER_M=0.0028
# DEEPSEEK_PRO_INPUT_USD_PER_M=0.435
# DEEPSEEK_PRO_OUTPUT_USD_PER_M=0.87
# DEEPSEEK_PRO_CACHED_INPUT_USD_PER_M=0.003625
# Post-promo pro (after 2026-05-31): input 1.74, cache 0.0145, output 3.48

# Engineering Forge partner handoff (server-only)
FORGE_BASE_URL=https://forge.lucastar.de
FORGE_PARTNER_SECRET=
# RATE_LIMIT_FORGE_HANDOFF_AUTH=5
