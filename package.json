{
  "name": "ai-engineering-team-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3100",
    "build": "prisma generate && node scripts/prisma-migrate-deploy-if-url.mjs && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "test": "node --import tsx --test src/test/**/*.test.ts"
  },
