generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IDLE
  RUNNING
  COMPLETE
  FAILED
}

model Project {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([updatedAt])
}

model Run {
  id         String     @id @default(cuid())
  projectId  String
  userPrompt String     @db.Text
  summary    String?    @db.Text
  status     RunStatus  @default(RUNNING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages   Message[]
  artifacts  Artifact[]

  @@index([projectId])
  @@index([createdAt])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  runId     String
  agentRole String
  content   String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
}

model Artifact {
  id        String   @id @default(cuid())
  runId     String
  type      String
  data      Json
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, type])
  @@index([runId])
}
