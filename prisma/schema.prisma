generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  IDLE
  RUNNING
  COMPLETE
  FAILED
}

enum ArtifactStatus {
  NONE
  PENDING
  GENERATING
  READY
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  runs         Run[]
}

model Project {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([updatedAt])
}

model Run {
  id               String     @id @default(cuid())
  projectId        String
  userId           String?
  guestSessionId   String?
  userPrompt       String     @db.Text
  summary          String?    @db.Text
  status           RunStatus      @default(RUNNING)
  artifactStatus   ArtifactStatus @default(NONE)
  promptTokens     Int        @default(0)
  completionTokens Int        @default(0)
  totalTokens      Int        @default(0)
  estimatedCostUsd Decimal?   @db.Decimal(10, 6)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages         Message[]
  artifacts        Artifact[]

  @@index([projectId])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([guestSessionId])
  @@index([guestSessionId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  runId     String
  agentRole String
  agentName String?
  content   String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
}

model Artifact {
  id        String   @id @default(cuid())
  runId     String
  type      String
  data      Json
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, type])
  @@index([runId])
}
